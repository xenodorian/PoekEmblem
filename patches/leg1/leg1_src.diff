diff --git a/src/eirika_attack.c b/src/eirika_attack.c
new file mode 100644
index 0000000..413bc46
--- /dev/null
+++ b/src/eirika_attack.c
@@ -0,0 +1,141 @@
+#include "global.h"
+#include "gflib.h"
+#include "battle.h"
+#include "battle_anim.h"
+#include "constants/species.h"
+#include "eirika_attack.h"
+
+#define EIRIKA_ATTACK_HOLD   8     // frames the idle pose is held after the swing
+#define EIRIKA_ATTACK_HIT    34    // frames from the start until the sword connects (the move effect starts here)
+#define EIRIKA_ATTACK_PAL_TAG 0xEA01
+
+// Canvas: 96x64, screen position (42, 46). Sprite A is the left 64x64, sprite B the right 32x64.
+#define EIRIKA_ATTACK_X_A    74
+#define EIRIKA_ATTACK_X_B    122
+#define EIRIKA_ATTACK_Y      78
+
+#define tTimer   data[0]
+#define tBattler data[1]
+
+static const u16 sEirikaAttackPal[] = INCBIN_U16("graphics/battle_anims/eirika_attack/attack.gbapal");
+static const u8 sEirikaAttackGfxA[] = INCBIN_U8("graphics/battle_anims/eirika_attack/a.4bpp");
+static const u8 sEirikaAttackGfxB[] = INCBIN_U8("graphics/battle_anims/eirika_attack/b.4bpp");
+
+#include "data/eirika_attack_frames.h"
+
+static const union AnimCmd *const sEirikaAttackAnims[] = { sEirikaAttackAnim };
+
+static const struct SpritePalette sEirikaAttackPalette = { sEirikaAttackPal, EIRIKA_ATTACK_PAL_TAG };
+
+static const struct OamData sOamData_64x64 =
+{
+    .affineMode = ST_OAM_AFFINE_OFF,
+    .objMode = ST_OAM_OBJ_NORMAL,
+    .shape = SPRITE_SHAPE(64x64),
+    .size = SPRITE_SIZE(64x64),
+    .priority = 1,
+};
+
+static const struct OamData sOamData_32x64 =
+{
+    .affineMode = ST_OAM_AFFINE_OFF,
+    .objMode = ST_OAM_OBJ_NORMAL,
+    .shape = SPRITE_SHAPE(32x64),
+    .size = SPRITE_SIZE(32x64),
+    .priority = 1,
+};
+
+static void SpriteCB_EirikaAttack(struct Sprite *sprite);
+
+static const struct SpriteTemplate sSpriteTemplate_EirikaAttackA =
+{
+    .tileTag = TAG_NONE,
+    .paletteTag = EIRIKA_ATTACK_PAL_TAG,
+    .oam = &sOamData_64x64,
+    .anims = sEirikaAttackAnims,
+    .images = sEirikaAttackImagesA,
+    .affineAnims = gDummySpriteAffineAnimTable,
+    .callback = SpriteCB_EirikaAttack,
+};
+
+static const struct SpriteTemplate sSpriteTemplate_EirikaAttackB =
+{
+    .tileTag = TAG_NONE,
+    .paletteTag = EIRIKA_ATTACK_PAL_TAG,
+    .oam = &sOamData_32x64,
+    .anims = sEirikaAttackAnims,
+    .images = sEirikaAttackImagesB,
+    .affineAnims = gDummySpriteAffineAnimTable,
+    .callback = SpriteCB_EirikaAttack,
+};
+
+static u8 sEirikaSpriteIdA;
+static u8 sEirikaSpriteIdB;
+static u8 sEirikaBattler;
+static bool8 sEirikaAttackActive;
+
+static void SpriteCB_EirikaAttack(struct Sprite *sprite)
+{
+    sprite->tTimer++;
+}
+
+bool8 ShouldPlayEirikaAttack(u8 battler)
+{
+    return GetBattlerSide(battler) == B_SIDE_PLAYER && gBattleMons[battler].species == SPECIES_EIRIKA;
+}
+
+void StartEirikaAttack(u8 battler)
+{
+    LoadSpritePalette(&sEirikaAttackPalette);
+    sEirikaBattler = battler;
+    sEirikaSpriteIdA = CreateSprite(&sSpriteTemplate_EirikaAttackA, EIRIKA_ATTACK_X_A, EIRIKA_ATTACK_Y, 0);
+    sEirikaSpriteIdB = CreateSprite(&sSpriteTemplate_EirikaAttackB, EIRIKA_ATTACK_X_B, EIRIKA_ATTACK_Y, 0);
+    gSprites[sEirikaSpriteIdA].tBattler = battler;
+    gSprites[sEirikaSpriteIdB].tBattler = battler;
+    gSprites[gBattlerSpriteIds[battler]].invisible = TRUE;
+    sEirikaAttackActive = TRUE;
+}
+
+// Called every frame before the OAM is built: her portrait, and any copies of it that move animations
+// make (after-images and the like), are never drawn while her attack animation is on screen
+void HideEirikaPortraitSprites(void)
+{
+    u32 i;
+    struct Sprite *portrait;
+
+    if (!sEirikaAttackActive)
+        return;
+    portrait = &gSprites[gBattlerSpriteIds[sEirikaBattler]];
+    portrait->invisible = TRUE;
+    for (i = 0; i < MAX_SPRITES; i++)
+    {
+        if (gSprites[i].inUse && &gSprites[i] != portrait
+         && gSprites[i].template == portrait->template && gSprites[i].oam.tileNum == portrait->oam.tileNum)
+            gSprites[i].invisible = TRUE;
+    }
+}
+
+// True while Eirika's attack is on screen in place of this battler's portrait
+bool8 IsEirikaAttackHidingBattler(u8 battler)
+{
+    return sEirikaAttackActive && sEirikaBattler == battler;
+}
+
+bool8 HasEirikaAttackReachedHit(void)
+{
+    return gSprites[sEirikaSpriteIdA].tTimer >= EIRIKA_ATTACK_HIT;
+}
+
+bool8 IsEirikaAttackDone(void)
+{
+    return gSprites[sEirikaSpriteIdA].animEnded && gSprites[sEirikaSpriteIdB].animEnded;
+}
+
+void EndEirikaAttack(void)
+{
+    DestroySprite(&gSprites[sEirikaSpriteIdA]);
+    DestroySprite(&gSprites[sEirikaSpriteIdB]);
+    FreeSpritePaletteByTag(EIRIKA_ATTACK_PAL_TAG);
+    sEirikaAttackActive = FALSE;
+    gSprites[gBattlerSpriteIds[sEirikaBattler]].invisible = FALSE;
+}
