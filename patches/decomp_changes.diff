+// Recruits a friendly character (VAR_0x8004 = species): level of the strongest party member, all IVs 31.
+// VAR_RESULT: 0 joined the party, 1 sent to the PC, 2 no room. The species name goes to STR_VAR_1.
+void RecruitAlly(void)
+{
+    u16 species = gSpecialVar_0x8004;
+    u8 level = 5;
+    u32 i;
+    u16 nationalDexNum = SpeciesToNationalPokedexNum(species);
+    struct Pokemon *mon = AllocZeroed(sizeof(struct Pokemon));
+
+    for (i = 0; i < PARTY_SIZE; i++)
+    {
+        if (GetMonData(&gPlayerParty[i], MON_DATA_SPECIES) != SPECIES_NONE && GetMonData(&gPlayerParty[i], MON_DATA_LEVEL) > level)
+            level = GetMonData(&gPlayerParty[i], MON_DATA_LEVEL);
+    }
+    CreateMon(mon, species, level, 31, FALSE, 0, OT_ID_PLAYER_ID, 0);
+    StringCopy(gStringVar1, gSpeciesNames[species]);
+    gSpecialVar_Result = GiveMonToPlayer(mon);
+    if (gSpecialVar_Result != MON_CANT_GIVE)
+    {
+        GetSetPokedexFlag(nationalDexNum, FLAG_SET_SEEN);
+        GetSetPokedexFlag(nationalDexNum, FLAG_SET_CAUGHT);
+    }
+    Free(mon);
+}
